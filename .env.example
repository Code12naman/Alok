# Set the sale's absolute ISO 8601 date/time including Z or an explicit UTC offset.
# Format: YYYY-MM-DDTHH:mm:ss+05:30
NEXT_PUBLIC_FLASH_SALE_END_AT=2026-10-31T23:59:59+05:30

# Firebase Admin SDK credentials used by trusted checkout routes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server-only Razorpay credentials. Never use NEXT_PUBLIC_ for these variables.
# Start with Test Mode keys; configure the matching webhook secret separately.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
