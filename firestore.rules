rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCodPaymentConfirmation() {
      return isAdmin()
        && resource.data.paymentMethod == "COD"
        && resource.data.paymentStatus == "Pending"
        && request.resource.data.paymentMethod == "COD"
        && request.resource.data.paymentStatus == "Paid"
        && request.resource.data.paymentConfirmedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentStatus', 'paymentConfirmedAt', 'paymentConfirmedBy', 'updatedAt'
        ]);
    }

    // Products: Anyone can read active/published products
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'reviewCount', 'updatedAt']));

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
        allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      }
    }

    match /{path=**}/reviews/{reviewId} {
      allow read, write: if isAdmin();
    }

    // Categories: Anyone can read, only admin can create/update/delete
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users:
    // - Authenticated user can read/update their own profile (cannot set/change role to "admin")
    // - Admin can read/write any user document
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated()
                    && isOwner(userId)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role in ['customer', 'admin']
                    && (request.resource.data.role != 'admin' || isAdmin());
      allow update: if isAdmin()
                    || (isOwner(userId)
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.customerId == resource.data.customerId
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role', 'customerId']));
      allow delete: if isAdmin();

      // Subcollections under users (cart, addresses, wishlist, etc.)
      match /cart/{cartId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /wishlist/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /{subcollection=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Orders:
    // - User can read their own orders or create their own order
    // - Admin can read/write all orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.customerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId
                    && request.resource.data.orderId == orderId
                    && request.resource.data.paymentStatus in ['Pending', 'Paid']
                    && request.resource.data.paymentMethod in ['COD', 'Razorpay'];
      allow update: if isAdmin() && (isCodPaymentConfirmation() || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'paymentStatus', 'paymentConfirmedAt', 'paymentConfirmedBy'
      ]));
      allow delete: if isAdmin();
    }

    // Coupons: Anyone can read active coupons, only admin can manage
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
